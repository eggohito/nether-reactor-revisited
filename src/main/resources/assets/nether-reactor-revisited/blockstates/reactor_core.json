{
	"multipart": [
		{
			"when": {
				"phase": "normal"
			},
			"apply": {
				"model": "nether-reactor-revisited:block/reactor_core/normal"
			}
		},
		{
			"when": {
				"OR": [
					{
						"phase": "activating"
					},
					{
						"phase": "activated_stable"
					},
					{
						"phase": "activated_unstable"
					}
				]
			},
			"apply": {
				"model": "nether-reactor-revisited:block/reactor_core/activated"
			}
		},
		{
			"when": {
				"OR": [
					{
						"phase": "deactivating"
					},
					{
						"phase": "deactivated"
					}
				]
			},
			"apply": {
				"model": "nether-reactor-revisited:block/reactor_core/deactivated"
			}
		}
	]
}